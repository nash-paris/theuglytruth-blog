---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const byYear: Record<string, typeof posts> = {};
posts.forEach(p => {
  const y = p.data.date.getFullYear().toString();
  if (!byYear[y]) byYear[y] = [];
  byYear[y].push(p);
});
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title="Archives — The Ugly Truth" description="Toutes les éditions de The Ugly Truth, par Nash.">
  <Header />
  <main class="archives-main">
    <header class="archives-header">
      <h1>Archives</h1>
      <p class="count">{posts.length} éditions publiées</p>
    </header>

    {years.map(year => (
      <section class="year-section">
        <h2 class="year-title">{year}</h2>
        <div class="post-grid">
          {byYear[year].map(post => (
            <a href={`/blog/${post.slug}/`} class="post-card">
              {post.data.coverImage && (
                <div class="card-cover">
                  <img src={post.data.coverImage} alt={post.data.title} loading="lazy" />
                </div>
              )}
              <div class="card-body">
                <time class="post-date" datetime={post.data.date.toISOString()}>
                  {fmt(post.data.date)}
                </time>
                <h3 class="card-title">{post.data.title}</h3>
                {post.data.subtitle && (
                  <p class="card-subtitle">{post.data.subtitle}</p>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
  <Footer />

  <style>
    .archives-main { max-width: 1100px; padding: 2.5rem 1.5rem 4rem; }
    .archives-header { margin-bottom: 2.5rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--border); }
    .archives-header h1 {
      font-family: var(--font-serif);
      font-size: clamp(2rem, 4vw, 2.8rem);
      letter-spacing: -0.02em;
    }
    .count { color: var(--muted); font-size: 1rem; margin-top: 0.3rem; }

    .year-section { margin-bottom: 3.5rem; }
    .year-title {
      font-family: var(--font-serif);
      font-size: 1.6rem;
      color: var(--muted);
      margin-bottom: 1.4rem;
      padding-bottom: 0.4rem;
      border-bottom: 1px solid var(--border);
    }

    .post-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.4rem;
    }
    .post-card {
      display: flex;
      flex-direction: column;
      color: var(--fg);
      background: white;
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      transition: box-shadow 0.15s, transform 0.15s;
    }
    .post-card:hover {
      box-shadow: 0 6px 22px rgba(0,0,0,.07);
      transform: translateY(-2px);
      text-decoration: none;
    }
    .card-cover { aspect-ratio: 16 / 10; overflow: hidden; background: #f5f5f5; }
    .card-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .card-body { padding: 0.9rem 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.35rem; }
    .post-date { color: var(--muted); font-size: 0.8rem; }
    .card-title {
      font-family: var(--font-serif);
      font-size: 1.05rem;
      line-height: 1.3;
      letter-spacing: -0.01em;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card-subtitle {
      color: var(--muted);
      font-size: 0.88rem;
      line-height: 1.45;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>
</BaseLayout>
